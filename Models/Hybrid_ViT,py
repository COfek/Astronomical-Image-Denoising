import torch
import torch.nn as nn

# === ViT Block ===
class ViTBlock(nn.Module):
    def __init__(self, dim, heads=4, dropout=0.1):
        super().__init__()
        self.norm1 = nn.LayerNorm(dim)
        self.attn = nn.MultiheadAttention(dim, heads, dropout=dropout, batch_first=True)
        self.norm2 = nn.LayerNorm(dim)
        self.ffn = nn.Sequential(
            nn.Linear(dim, dim * 4),
            nn.GELU(),
            nn.Linear(dim * 4, dim),
        )

    def forward(self, x):
        x = self.norm1(x)
        attn_out, _ = self.attn(x, x, x)
        x = x + attn_out
        x = x + self.ffn(self.norm2(x))
        return x

# === Hybrid ViT Denoiser ===
class HybridViTDenoiser(nn.Module):
    def __init__(self, img_size=256, patch_size=8, dim=128, depth=4):
        super().__init__()
        assert img_size % patch_size == 0
        self.img_size = img_size
        self.patch_size = patch_size
        self.num_patches = (img_size // patch_size) ** 2
        self.token_dim = dim

        # CNN Encoder: Downsample image to patch-level features
        self.encoder = nn.Sequential(
            nn.Conv2d(1, 64, 3, stride=2, padding=1),  # 256 -> 128
            nn.ReLU(),
            nn.Conv2d(64, dim, 3, stride=2, padding=1),  # 128 -> 64
            nn.ReLU()
        )

        # Positional Embedding + Transformer
        self.pos_embed = nn.Parameter(torch.randn(1, self.num_patches, dim))
        self.transformer = nn.Sequential(*[ViTBlock(dim) for _ in range(depth)])

        # CNN Decoder: Upsample back to full image
        self.decoder = nn.Sequential(
            nn.ConvTranspose2d(dim, 64, 4, stride=2, padding=1),  # 64 → 128
            nn.ReLU(),
            nn.ConvTranspose2d(64, 32, 4, stride=2, padding=1),   # 128 → 256
            nn.ReLU(),
            nn.Conv2d(32, 1, 3, padding=1),
            nn.Sigmoid()
        )

    def forward(self, x):
        B = x.shape[0]
        # CNN Encoder
        feats = self.encoder(x)  # (B, dim, H/4, W/4) = (B, 128, 64, 64)

        # Flatten to patch tokens
        tokens = feats.flatten(2).transpose(1, 2)  # (B, N=4096, dim)
        tokens = tokens + self.pos_embed
        tokens = self.transformer(tokens)

        # Reshape back to image-like map
        feats_out = tokens.transpose(1, 2).reshape(B, self.token_dim, self.img_size // 4, self.img_size // 4)

        # CNN Decoder
        out = self.decoder(feats_out)
        return out
